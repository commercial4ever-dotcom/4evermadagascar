# GEMINI_API_KEY: Required for optional AI-assisted PDF catalogue extraction in Admin.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for the Contact showroom map.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# ADMIN_EMAIL / ADMIN_PASSWORD_HASH: Optional server-side primary administrator credentials.
# If unset, the first visit to /admin presents a secure one-time setup flow.
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""
SESSION_SECRET=""

# SMTP configuration for real email transmission to commercial4ever@gmail.com
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
QUOTE_RECIPIENT_EMAIL="commercial4ever@gmail.com"
