# -------------------------------------------------------------------
# 4EVER Madagascar — Variables d'environnement serveur (.env)
# Ne jamais commiter de secrets réels ni les exposer côté frontend.
# -------------------------------------------------------------------

# --- APPLICATION ---
# En développement : NODE_ENV="development" (autorise SQLite local + disque local)
# En production : NODE_ENV="production" (EXIGE Cloudflare D1 + SESSION_SECRET ; zéro repli SQLite local)
NODE_ENV="development"
PORT="3000"
APP_URL="https://votre-domaine.mg"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# --- SÉCURITÉ SUPER ADMIN ---
# Jeton secret à usage unique requis pour créer le tout premier compte Super Admin sur /admin.
# Générez une chaîne aléatoire longue (ex: openssl rand -hex 32).
# Une fois le premier Super Admin créé, l'initialisation est définitivement verrouillée.
ADMIN_SETUP_TOKEN=""
# Clé HMAC pour la signature des cookies de session (minimum 32 caractères aléatoires, OBLIGATOIRE en prod).
SESSION_SECRET=""

# --- CLOUDFLARE D1 (Obligatoire en production) ---
# Mode A (Recommandé en production) : Worker D1 Bridge déployé avec binding natif vers votre base D1 existante
CLOUDFLARE_D1_BRIDGE_URL=""
CLOUDFLARE_D1_BRIDGE_TOKEN=""

# Mode B (Alternative si vous n'utilisez pas le Worker Bridge) : Cloudflare D1 REST API
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_D1_DATABASE_ID=""
CLOUDFLARE_API_TOKEN=""

# --- CLOUDFLARE R2 (TEMPORAIREMENT REPORTÉ / OPTIONNEL) ---
# Tant que R2 n'est pas activé dans votre compte Cloudflare, laissez ces variables vides.
# En production sans R2 : D1, le catalogue, les devis (sans fichier), les contenus et l'admin fonctionnent normalement ;
# les téléversements de fichiers sont temporairement désactivés sans repli sur disque local.
# Quand R2 sera activé plus tard, séparez strictement les deux buckets :
CLOUDFLARE_R2_PUBLIC_BUCKET=""
CLOUDFLARE_R2_PRIVATE_BUCKET=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_PUBLIC_URL=""

# --- E-MAILS SMTP (Demandes de devis & contact vers commercial4ever@gmail.com) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
QUOTE_RECIPIENT_EMAIL="commercial4ever@gmail.com"
